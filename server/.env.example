# ─── Server (local + Render) ───
NODE_ENV=development
PORT=3001

# ─── Neon PostgreSQL (Dashboard → Connect → Pooled) ───
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ─── CORS: Vercel + local (sin barra final) ───
CORS_ORIGINS=http://localhost:5173,https://tu-app.vercel.app

# ─── Firebase Admin (Project Settings → Service accounts → Generate key) ───
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Servicio Python ceromancia (local o segundo deploy Railway) ───
# Puerto 8002 si el 8000 está ocupado por otra app
CEROMANCY_SERVICE_URL=http://127.0.0.1:8002

# ─── Rate limit ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
